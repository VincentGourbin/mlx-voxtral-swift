{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VincentGourbin/mlx-voxtral-swift/docs/bench.schema.json",
  "title": "VoxtralCLI bench line (K-32)",
  "description": "One JSON object per measured pass, printed as `BENCH {json}` and appended to bench.jsonl. Copied verbatim into BENCHMARKS.md, never edited.",
  "type": "object",
  "required": ["date", "commit", "dirty", "build", "mlx_swift", "mlx_swift_lm", "mlx_profiler", "chip", "ram_gb", "macos",
               "power", "top_process", "pipeline", "model", "pass", "tag", "warm", "total_ms", "phases_ms", "peak_mlx_mb",
               "peak_footprint_mb", "steps", "out_sha256"],
  "properties": {
    "date": {"type": "string", "format": "date-time"},
    "commit": {"type": "string"},
    "dirty": {"type": "boolean"},
    "build": {"enum": ["Release"]},
    "mlx_swift": {"type": "string", "description": "resolved revision, e.g. 0.31.6@0bb916c67"},
    "mlx_swift_lm": {"type": "string"},
    "mlx_profiler": {"type": "string"},
    "chip": {"type": "string"},
    "ram_gb": {"type": "integer"},
    "macos": {"type": "string"},
    "power": {"type": "string"},
    "top_process": {"type": "string"},
    "pipeline": {"enum": ["stt", "tts", "realtime", "enroll", "chat"]},
    "model": {"type": "string"},
    "backend": {"enum": ["mlx", "auto", "hybrid"]},
    "profile": {"type": "string"},
    "pack_sha256": {"type": "string"},
    "input": {"type": "string"},
    "input_s": {"type": "number"},
    "language": {"type": "string"},
    "seed": {"type": "integer"},
    "pass": {"type": "integer", "minimum": 1},
    "tag": {"type": "string"},
    "warm": {"type": "boolean"},
    "load_ms": {"type": "number"},
    "total_ms": {"type": "number", "exclusiveMinimum": 0, "description": "pass wall time, model loading excluded"},
    "phases_ms": {"type": "object", "additionalProperties": {"type": "number"}, "description": "exclusive time per phase (a phase containing others counts only its own time): the sum is at most total_ms"},
    "peak_mlx_mb": {"type": "number", "description": "Memory.peakMemory, reset by the instrument at the pass start"},
    "peak_mlx_mb_by_phase": {"type": "object", "additionalProperties": {"type": "number"}},
    "peak_footprint_mb": {"type": "number", "description": "phys_footprint, 5 ms sampler"},
    "steps": {"type": "integer"},
    "step_ms_p50": {"type": "number"},
    "step_ms_p90": {"type": "number"},
    "ttft_ms": {"type": "number"},
    "rtf": {"type": "number"},
    "out_sha256": {"type": "string", "description": "text (STT/Realtime/chat), int16 waveform (TTS), embedding (enroll)"},
    "chars": {"type": "integer"},
    "truncated": {"type": "boolean"},
    "encode_ms_per_audio_s": {"type": "number"},
    "pad_fraction": {"type": "number", "minimum": 0, "maximum": 1, "description": "realtime: share of decode steps whose token carries no text (control tokens: [STREAMING_PAD], [STREAMING_WORD]…) (K-36, K-73)"},
    "delay_ms": {"type": "integer"},
    "frames": {"type": "integer"},
    "audio_s": {"type": "number"},
    "ttfa_ms": {"type": "number"},
    "text_tokens": {"type": "integer", "description": "tts: text tokens read by the model (after sanitization)"},
    "frame_cap": {"type": "integer", "description": "tts: frame cap applied to the text (K-14)"},
    "streaming": {"type": "boolean"},
    "warm_up": {"type": "boolean"},
    "voice": {"type": "string"},
    "epochs": {"type": "integer"},
    "epoch_ms_p50": {"type": "number"},
    "final_loss": {"type": "number"},
    "after_synthesis": {"type": "boolean"},
    "question": {"type": "integer"},
    "temperature": {"type": "number"},
    "tok_s": {"type": "number"}
  },
  "additionalProperties": true
}
